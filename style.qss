QWidget {
    background-color: #1e2a38;
    color: #ffffff;
    font-size: 14px;
}

QPushButton {
    background-color: #0078d7;
    color: #fff;
    border-radius: 6px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: #005a9e;
}

QLineEdit, QDateEdit {
    background-color: #ffffff;
    color: #000000;
    border-radius: 4px;
    padding: 4px;
}

QTableWidget {
    background-color: #ffffff;
    color: #000000;
    gridline-color: #cccccc;
}
